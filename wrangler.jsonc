{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "admin",
  // The session sync (custom-worker.ts, /api/cms/sync); needs the CMS_SYNC_SECRET Worker secret.
  "triggers": { "crons": ["*/30 * * * *"] },
  // Keeps console output and errors so failures can be looked up in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "account_id": "9cadd6437c3f097aa6ed24cd045dddde",
  "compatibility_date": "2026-09-23",
  // Plain variables (CMS_API_URL, CMS_API_USERNAME, ...) are set in the Cloudflare dashboard and kept across deploys.
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "admin"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
