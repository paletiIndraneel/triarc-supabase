# Cloudflare Pages Function (functions/api/contact.ts) — set these as
# Cloudflare Pages environment variables/secrets, not in a committed .env file.
# EMAIL_API_URL / EMAIL_API_KEY must match the chosen HTTP email provider
# (e.g. Resend, Postmark, SendGrid) — no provider is selected yet.
EMAIL_API_URL=https://your-email-provider.example.com/send
EMAIL_API_KEY=your_email_provider_api_key
EMAIL_FROM=TriArc EV Hub Contact <no-reply@example.com>
CONTACT_RECIPIENT=your_recipient@example.com

# Admin login (functions/api/auth/login.ts, functions/admin/_middleware.ts)
# Gates the hidden /admin page reachable via /signin. Set as Cloudflare
# Pages secrets — never commit real values.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=your_random_session_signing_secret
