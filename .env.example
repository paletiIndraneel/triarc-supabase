# Supabase (public values: safe to expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server only (Cloudflare Worker secret / Vercel env var): stores the shared ChargeMOD login.
# Never add it to next.config.ts `env`, which is built into the browser bundle.
SUPABASE_SECRET_KEY=sb_secret_your_key

# CMS operator dashboard (optional).
# Set these as Cloudflare Worker variables/secrets: never commit real values.
# CMS_OPERATOR_DASHBOARD_ENABLED=true
# CMS_API_URL=https://ls.console.chargemod.com
# CMS_API_USERNAME=
# CMS_API_PASSWORD=
