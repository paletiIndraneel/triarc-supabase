{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "admin",
  "account_id": "9cadd6437c3f097aa6ed24cd045dddde",
  "compatibility_date": "2026-09-23",
  // Plain variables (CMS_API_URL, CMS_API_USERNAME, ...) are set in the Cloudflare dashboard and kept across deploys.
  "keep_vars": true,
  // A preview version (what Workers Builds publishes for a branch) does not inherit the
  // dashboard's plain variables, so `wrangler preview` refuses to run without them here. They
  // are the same non-secret values the dashboard holds; passwords and keys stay secrets and are
  // inherited. Keep this in step with the dashboard, or a branch build stops before publishing.
  "previews": {
    "vars": {
      "CMS_API_URL": "https://ls.console.chargemod.com",
      "CMS_API_USERNAME": "triarc@chargemod.com",
      "CMS_OPERATOR_DASHBOARD_ENABLED": "true",
      "SUPABASE_URL": "https://kgfxlqgbzvtqfrqbblfo.supabase.co"
    }
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "admin"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
