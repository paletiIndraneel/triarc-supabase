# Supabase (public values: safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# CMS operator dashboard (optional).
# Set these as Cloudflare Worker variables/secrets: never commit real values.
# See docs/CMS_OPERATOR_SETUP.md
# CMS_OPERATOR_DASHBOARD_ENABLED=true
# CMS_API_URL=https://ls.console.chargemod.com
# CMS_API_USERNAME=
# CMS_API_PASSWORD=
# CMS_API_LOCATION_ID=
